<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Production traffic is HTTPS only.
        Cleartext is permitted solely for local development hosts:
          10.0.2.2  the developer machine as seen from the Android emulator
          10.0.3.2  the same, from the Genymotion emulator
          localhost / 127.0.0.1
          *.local   hostnames mapped through the emulator gateway
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">host.docker.internal</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
